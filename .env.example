# Database Configuration
WORDPRESS_DB_NAME=blfa_db
WORDPRESS_DB_USER=blfa_user
WORDPRESS_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
WORDPRESS_DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=1

# Published Nginx Host Port
WORDPRESS_PORT=9000

# WordPress Core Installation Settings
WORDPRESS_TITLE="BLFA Demo WordPress"
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=adminpassword
WORDPRESS_ADMIN_EMAIL=admin@example.com